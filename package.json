{
  "name": "leaf-scan",
  "version": "1.0.0",
  "description": "Private, offline crop-disease image triage for farmers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Faisal01011/Leaf-Scan.git"
  },
  "bugs": {
    "url": "https://github.com/Faisal01011/Leaf-Scan/issues"
  },
  "homepage": "https://github.com/Faisal01011/Leaf-Scan#readme",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "npx --yes eas-cli@21.7.1 build -p android --profile preview",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "doctor": "expo-doctor",
    "validate": "npm run lint && npm test && npm run typecheck && npm run doctor",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.12",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-linear-gradient": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vision-camera": "^5.2.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "~22.20.0",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-import-resolver-typescript": "~3.10.1",
    "expo-doctor": "^1.20.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite",
          "react-native-nitro-image"
        ]
      }
    }
  },
  "private": true
}
