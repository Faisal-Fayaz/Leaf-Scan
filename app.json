{
  "expo": {
    "name": "LeafScan",
    "slug": "leaf-scan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LeafScan needs camera access to scan crops.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.leafscan.app"
    },
    "android": {
      "package": "com.leafscan.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#173E2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-image-picker",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "hi"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173E2B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2bc96316-93cd-4b80-ab20-a905eb022b1b"
      }
    }
  }
}
